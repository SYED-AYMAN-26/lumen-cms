# Server
PORT=4000
NODE_ENV=development

# MongoDB. Leave empty to start an in-memory MongoDB for local demo.
# Example: mongodb://127.0.0.1:27017/lumen
MONGODB_URI=

# Required in production. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated browser origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Seed demo roles, users, and content when the database is empty.
SEED_ON_START=true

# When true, forgot-password returns a reset link (local demo only).
DEMO_EXPOSE_RESET=true

# Upload directory, relative to the backend folder.
UPLOAD_DIR=uploads
